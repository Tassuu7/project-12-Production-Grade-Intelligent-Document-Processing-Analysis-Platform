# Application Environment Configuration
APP_NAME=Intelligent Document Processing & Analysis Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Authentication
SECRET_KEY=production-secure-random-secret-key-replace-in-production-use-256bit
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=doc_intel_session

# Database Configuration
DATABASE_URL=sqlite:///./data/database/doc_intel.db
DATABASE_ECHO=False

# Storage Configuration
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,xlsx

# Background Worker & Processing
WORKER_CONCURRENCY=4
MAX_JOB_RETRIES=3
JOB_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
ENABLE_AUDIT_LOG=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
